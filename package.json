{
  "name": "furnish",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend": "bun run --filter @furnish/backend",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev": "turbo dev",
    "dev:backend": "turbo -F @furnish/backend run dev",
    "dev:native": "turbo -F native dev",
    "dev:setup": "turbo -F @furnish/backend dev:setup",
    "dev:web": "turbo -F web dev",
    "fix": "bun x ultracite fix",
    "native": "bun run --filter @furnish/native",
    "prepare": "lefthook install",
    "web": "bun run --filter './apps/web'"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix",
      "bun x ultracite fix"
    ]
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "ai": "^7.0.107",
    "next": "^16.3.5",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@manypkg/cli": "^0.25.1",
    "concurrently": "^10.0.5",
    "lefthook": "^2.1.14",
    "lint-staged": "^17.5.1",
    "turbo": "2.11.2",
    "ultracite": "7.12.0"
  },
  "packageManager": "bun@1.2.18"
}
