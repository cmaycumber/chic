{
  "name": "furnish",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "native": "bun run --filter @furnish/native",
    "web": "bun run --filter './apps/web'",
    "backend": "bun run --filter @furnish/backend",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:backend": "turbo -F @furnish/backend run dev",
    "dev:setup": "turbo -F @furnish/backend dev:setup",
    "fix": "bun x ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@manypkg/cli": "^0.25.1",
    "concurrently": "^9.2.1",
    "lefthook": "^1.13.6",
    "lint-staged": "^16.2.4",
    "turbo": "2.5.8",
    "ultracite": "5.6.2"
  },
  "packageManager": "bun@1.2.18",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix",
      "bun x ultracite fix"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "ai": "^5.0.108",
    "next": "^16.0.8",
    "react-hook-form": "^7.66.1",
    "zod": "^4.1.12"
  }
}
