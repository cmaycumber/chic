{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "files": {
    // Remove the native files until we start working on the project.
    "includes": ["!**/apps/native", "!**/.omc"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAtRules": "warn",
        "noConsole": "warn"
      },
      "performance": {
        "noNamespaceImport": "warn",
        // New in ultracite 7; flags every inline arrow function passed as a JSX prop
        // (onClick, onChange, etc.), which is the idiomatic React pattern used
        // throughout this codebase. Forcing useCallback everywhere is noisy, not a
        // real bug, so this is a warning rather than a hard error.
        "noJsxPropsBind": "warn"
      },
      "style": {
        "noMagicNumbers": "warn",
        "useNamingConvention": "warn",
        "noNonNullAssertion": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/apps/native/app/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/convex/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/components/ui/**"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off",
            "noImgElement": "off"
          },
          "style": {
            "noNestedTernary": "off",
            "useCollapsedIf": "off"
          },
          "a11y": {
            "useFocusableInteractive": "off",
            "useSemanticElements": "off",
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off",
            "useImageSize": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noShadow": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["**/components/ai-elements/**"],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          },
          "correctness": {
            "useImageSize": "off"
          },
          "style": {
            "useCollapsedIf": "off"
          }
        }
      }
    }
  ]
}
